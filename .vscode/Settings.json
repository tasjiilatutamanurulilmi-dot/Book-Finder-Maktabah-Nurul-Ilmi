{
  "editor.defaultFormatter": "esbenpeter.prettier-vscode",
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "[html]": {
    "editor.defaultFormatter": "esbenpeter.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenpeter.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenpeter.prettier-vscode"
  },
  "files.eol": "\n",
  "prettier.requireConfig": true
}